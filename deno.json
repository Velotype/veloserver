{
  "name": "@velotype/veloserver",
  "license": "MIT",
  "version": "0.2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "publish": {
    "exclude": [
      "docs/",
      "tests/"
    ]
  },
  "imports": {
